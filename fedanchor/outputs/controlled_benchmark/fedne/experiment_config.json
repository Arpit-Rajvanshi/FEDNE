{
  "dataset": {
    "name": "MNIST",
    "data_dir": "./data"
  },
  "partition": {
    "type": "iid",
    "alpha": 0.5
  },
  "federated": {
    "clients": 2,
    "rounds": 20,
    "local_epochs": 1,
    "device": "cpu"
  },
  "model": {
    "input_dim": 784,
    "embedding_dim": 2,
    "hidden_dims": [
      512,
      256,
      128
    ]
  },
  "graph": {
    "k": 5,
    "negative_samples": 5,
    "with_replacement": true
  },
  "augmentation": {
    "enabled": false
  },
  "surrogate": {
    "hidden_dim": 64,
    "grid_step": 0.3,
    "margin": 0.5,
    "lr": 0.001,
    "epochs": 2,
    "start_round": 0
  },
  "optimizer": {
    "lr": 0.001,
    "weight_decay": 0.0,
    "lr_decay_rounds": [],
    "lr_decay_factor": 1.0
  },
  "logging": {
    "tensorboard": false,
    "log_dir": "./runs",
    "checkpoint_dir": "./checkpoints",
    "output_dir": "./outputs",
    "seed": 42
  }
}